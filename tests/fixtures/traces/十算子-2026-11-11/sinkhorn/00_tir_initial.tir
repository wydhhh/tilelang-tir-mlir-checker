# from tvm.script import ir as I
# from tvm.script import tir as T

@I.ir_module
class Module:
    @T.prim_func
    def mhc_sinkhorn_kernel(comb_res_mix_handle: T.handle, comb_res_mix_out_handle: T.handle):
        num_tokens = T.int32()
        comb_res_mix = T.match_buffer(comb_res_mix_handle, (num_tokens, 4, 4), strides=(16, 4, 1))
        comb_res_mix_out = T.match_buffer(comb_res_mix_out_handle, (num_tokens, 4, 4), strides=(16, 4, 1))
        # with T.block("root"):
        bx = T.launch_thread("blockIdx.x", (num_tokens + 2 - 1) // 2)
        tx = T.launch_thread("threadIdx.x", 128)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        with T.block("tilelang_root"):
            T.reads(comb_res_mix[bx * 2, 0, 0], comb_res_mix_out[bx * 2, 0, 0])
            T.writes()
            comb_frag = T.alloc_buffer((2, 4, 4), scope="local.fragment")
            row_sum = T.alloc_buffer((2, 4), scope="local.fragment")
            col_sum = T.alloc_buffer((2, 4), scope="local.fragment")
            row_max = T.alloc_buffer((2, 4), scope="local.fragment")
            T.copy(T.region(comb_res_mix[bx * 2, 0, 0], 1, 2, 4, 4), T.region(comb_frag[0, 0, 0], 2, 2, 4, 4))
            T.reduce(comb_frag[0:2, 0:4, 0:4], row_max[0:2, 0:4], "max", 2, T.bool(True))
            for i in T.parallel(2):
                for j in T.parallel(4):
                    for k in T.parallel(4):
                        comb_frag[i, j, k] = T.exp(comb_frag[i, j, k] - row_max[i, j])
            T.reduce(comb_frag[0:2, 0:4, 0:4], row_sum[0:2, 0:4], "sum", 2, T.bool(True))
            for i in T.parallel(2):
                for j in T.parallel(4):
                    for k in T.parallel(4):
                        comb_frag[i, j, k] = comb_frag[i, j, k] / row_sum[i, j] + T.float32(9.9999999999999995e-07)
            T.reduce(comb_frag[0:2, 0:4, 0:4], col_sum[0:2, 0:4], "sum", 1, T.bool(True))
            for i in T.parallel(2):
                for j in T.parallel(4):
                    for k in T.parallel(4):
                        comb_frag[i, j, k] = comb_frag[i, j, k] / (col_sum[i, k] + T.float32(9.9999999999999995e-07))
            for _ in range(2):
                T.reduce(comb_frag[0:2, 0:4, 0:4], row_sum[0:2, 0:4], "sum", 2, T.bool(True))
                for i in T.parallel(2):
                    for j in T.parallel(4):
                        for k in T.parallel(4):
                            comb_frag[i, j, k] = comb_frag[i, j, k] / (row_sum[i, j] + T.float32(9.9999999999999995e-07))
                T.reduce(comb_frag[0:2, 0:4, 0:4], col_sum[0:2, 0:4], "sum", 1, T.bool(True))
                for i in T.parallel(2):
                    for j in T.parallel(4):
                        for k in T.parallel(4):
                            comb_frag[i, j, k] = comb_frag[i, j, k] / (col_sum[i, k] + T.float32(9.9999999999999995e-07))
            T.copy(T.region(comb_frag[0, 0, 0], 1, 2, 4, 4), T.region(comb_res_mix_out[bx * 2, 0, 0], 2, 2, 4, 4))