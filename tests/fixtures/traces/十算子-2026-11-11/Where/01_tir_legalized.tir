# from tvm.script import ir as I
# from tvm.script import tir as T

@I.ir_module
class Module:
    @T.prim_func
    def main(cond_handle: T.handle, x_handle: T.handle, y_in_handle: T.handle, out_handle: T.handle):
        T.func_attr({"target": T.target({"host": {"keys": ["cpu"], "kind": "c", "tag": ""}, "keys": [], "kind": "riscv", "tag": ""})})
        cond = T.match_buffer(cond_handle, (2048,), "uint8", strides=(1,))
        x = T.match_buffer(x_handle, (2048,), strides=(1,))
        y_in = T.match_buffer(y_in_handle, (2048,), strides=(1,))
        out = T.match_buffer(out_handle, (2048,), strides=(1,))
        # with T.block("root"):
        bx = T.launch_thread("blockIdx.x", 4)
        tx = T.launch_thread("threadIdx.x", 128)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        with T.block("tilelang_root"):
            T.reads(cond[bx * 512], x[bx * 512], y_in[bx * 512], out[bx * 512])
            T.writes()
            c_reg = T.alloc_buffer((512,), "uint8", scope="local.fragment")
            x_reg = T.alloc_buffer((512,), scope="local.fragment")
            y_reg = T.alloc_buffer((512,), scope="local.fragment")
            T.copy(T.region(cond[bx * 512], 1, 512), T.region(c_reg[0], 2, 512))
            T.copy(T.region(x[bx * 512], 1, 512), T.region(x_reg[0], 2, 512))
            T.copy(T.region(y_in[bx * 512], 1, 512), T.region(y_reg[0], 2, 512))
            for i in T.parallel(128):
                for j in T.parallel(4):
                    x_reg[i * 4 + j] = T.if_then_else(c_reg[i * 4 + j] != T.uint8(0), x_reg[i * 4 + j], y_reg[i * 4 + j])
            T.copy(T.region(x_reg[0], 1, 512), T.region(out[bx * 512], 2, 512))