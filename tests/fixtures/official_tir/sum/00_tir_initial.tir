# from tvm.script import ir as I
# from tvm.script import tir as T

@I.ir_module
class Module:
    @T.prim_func
    def main(x_handle: T.handle, out_handle: T.handle):
        x = T.match_buffer(x_handle, (2, 33), strides=(33, 1))
        out = T.match_buffer(out_handle, (2,), strides=(1,))
        # with T.block("root"):
        bx = T.launch_thread("blockIdx.x", 2)
        tx = T.launch_thread("threadIdx.x", 128)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        with T.block("tilelang_root"):
            T.reads(x[bx, 0:256], out[bx])
            T.writes()
            shared_buf = T.alloc_buffer((1, 256), scope="shared.dyn")
            x_f32 = T.alloc_buffer((1, 256), scope="local.fragment")
            acc = T.alloc_buffer((1,), scope="local.fragment")
            out_local = T.alloc_buffer((1,), scope="local.fragment")
            for i in range(1):
                for j in T.parallel(256):
                    x_f32[i, j] = T.if_then_else(bx + i < 2 and j < 33, x[bx + i, j], T.float32(0.0))
            T.reduce(x_f32[0, 0:256], acc[0], "sum", 1, T.bool(True))
            for i in T.parallel(1):
                out_local[i] = acc[i]
            T.copy(T.region(out_local[0], 1, 1), T.region(out[bx], 2, 1))